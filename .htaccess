<IfModule mod_headers.c>
    <Files "apple-app-site-association">
        Header set Content-Type "application/json"
    </Files>
</IfModule>

# Allow access to .well-known directory (Apache blocks dot-dirs by default)
<IfModule mod_authz_core.c>
    <Directory ".well-known">
        Require all granted
    </Directory>
</IfModule>

# Set correct Content-Type for both deep-link files
<FilesMatch "^(apple-app-site-association(\.json)?|assetlinks\.json)$">
    <IfModule mod_headers.c>
        Header set Content-Type "application/json"
    </IfModule>
</FilesMatch>
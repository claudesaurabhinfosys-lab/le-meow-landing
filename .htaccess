# Serve apple-app-site-association without .json extension
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteRule ^\.well-known/apple-app-site-association$ .well-known/apple-app-site-association.json [L,T=application/json]
</IfModule>

# Set correct Content-Type for deep-link files
<IfModule mod_headers.c>
    <FilesMatch "^(apple-app-site-association(?:\.json)?|assetlinks\.json)$">
        Header set Content-Type "application/json"
    </FilesMatch>
</IfModule>